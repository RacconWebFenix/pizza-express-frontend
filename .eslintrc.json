{
  "extends": "next",
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-filename-extension": "off",
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/*.test.js",
          "**/*.test.jsx",
          "**/*.test.ts",
          "**/*.test.tsx",
          "**/jest.*.js"
        ]
      }
    ],
    "react/display-name": "off",
    "jest/no-mocks-import": "off"
  },
  "overrides": [
    {
      "files": [
        "**/__tests__/**/*.[jt]s?(x)",
        "**/?(*.)+(spec|test).[jt]s?(x)"
      ],
      "env": {
        "jest": true
      },
      "rules": {
        "react/jsx-props-no-spreading": "off"
      }
    }
  ]
}
